#!/bin/sh
# TFT Coach launcher — uses the repo venv (modern Python + Tk 9).
# The system python3 ships Tk 8.5 (2011): blank white windows, no floating.
cd "$(dirname "$0")" || exit 1
if [ ! -x .venv/bin/python ]; then
  echo "venv missing — run: python3.14 -m venv .venv && .venv/bin/pip install mss pillow numpy pytesseract pyobjc-framework-Cocoa"
  exit 1
fi
exec .venv/bin/python run_coach.py "$@"
